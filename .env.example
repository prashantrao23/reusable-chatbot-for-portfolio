# ==============================================================================
# PORTFOLIO CHATBOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDER SELECTION
# ------------------------------------------------------------------------------
# Choose which AI provider to use.
# Available options:
#   - nvidia      -> NVIDIA NIM (FREE 1,000 developer credits at https://build.nvidia.com)
#   - gemini      -> Google Gemini (FREE tier with high limits at https://aistudio.google.com)
#   - groq        -> Groq Cloud (FREE tier, ultra-fast LPU inference at https://console.groq.com)
#   - ollama      -> Ollama (100% FREE, local, offline, no API key needed at https://ollama.com)
#   - claude      -> Anthropic Claude (https://console.anthropic.com)
#   - openai      -> OpenAI ChatGPT (https://platform.openai.com)
#   - openrouter  -> OpenRouter (https://openrouter.ai)
#   - deepseek    -> DeepSeek (https://platform.deepseek.com)
#   - mistral     -> Mistral AI (https://console.mistral.ai)
#
# If left empty, the server auto-detects based on whichever API key is set below.
AI_PROVIDER=groq

# Optional: Override the model name. If blank, sensible defaults are used:
#   claude:     claude-haiku-5-5 (or claude-sonnet-5-5)
#   nvidia:     meta/llama-3.3-70b-instruct
#   gemini:     gemini-flash-latest (always the current Flash model)
#   groq:       openai/gpt-oss-120b
#   openai:     gpt-4o-mini
#   ollama:     llama3.2 (or mistral, qwen2.5)
#   openrouter: meta-llama/llama-3.3-70b-instruct:free
#   deepseek:   deepseek-chat
#   mistral:    mistral-small-latest
# Model names change often. If you see a "model not found" error in the server log,
# set AI_MODEL to a model from your provider's current model list.
AI_MODEL=

# ------------------------------------------------------------------------------
# 2. PROVIDER API KEYS (Fill in the key for your selected provider)
# ------------------------------------------------------------------------------

# [Option A - Free Tier] NVIDIA NIM (1,000 Free Credits)
# Get key: https://build.nvidia.com
NVIDIA_API_KEY=

# [Option B - Free Tier] Google Gemini (Free tier, generous quota)
# Get key: https://aistudio.google.com
GEMINI_API_KEY=

# [Option C - Free Tier] Groq Cloud (Free tier, blazing fast LPU inference)
# Get key: https://console.groq.com
GROQ_API_KEY=

# [Option D - 100% Free / Local] Ollama (No API key needed)
# Download from https://ollama.com and run: ollama run llama3.2
# Optional custom URL (default is http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# [Option E] Anthropic Claude (default)
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional older setting. AI_MODEL takes precedence over this.
# CLAUDE_MODEL=claude-haiku-5-5

# [Option F] OpenAI ChatGPT
# Get key: https://platform.openai.com
OPENAI_API_KEY=

# [Option G] OpenRouter (Multi-model gateway with free models)
# Get key: https://openrouter.ai
OPENROUTER_API_KEY=

# [Option H] DeepSeek
# Get key: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# [Option I] Mistral AI
# Get key: https://console.mistral.ai
MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# 3. GENERAL SERVER SETTINGS
# ------------------------------------------------------------------------------

# Port to run the server on (default: 3000)
PORT=3000

# Name of the candidate / portfolio owner.
# If left blank, it automatically uses the first line of your resume.
OWNER_NAME=Jhon

# Comma-separated list of origins allowed to embed the chatbot widget.
# Empty = any site (great for testing).
# In production, set to your domain, e.g.: https://yourname.dev,https://www.yourname.dev
ALLOWED_ORIGINS=

# Set to 1 if deploying behind a reverse proxy (Render, Railway, Fly.io, Nginx)
# to ensure rate limits track the visitor's real IP address.
TRUST_PROXY=

# Maximum length of each reply, in tokens. Keep it at 1200 or higher: reasoning models
# (gpt-oss, Gemini 3, DeepSeek) use part of this for hidden thinking.
MAX_TOKENS=1200

# Maximum chat requests allowed per day across all visitors (protects your bill)
MAX_DAILY_REQUESTS=500

# Extra instructions appended to the AI prompt (e.g., "Mention that I am open to remote roles.")
EXTRA_INSTRUCTIONS= I am open to Remote roles, and Fullstack developer roles.

# Suggested starter question chips shown to first-time visitors, separated by |
SUGGESTIONS=Summarize the experience|What are the key skills?|Tell me about recent projects
